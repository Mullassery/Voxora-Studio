# Voxora Studio local development. Copy to .env and replace placeholders.
VOXORA_ENV=development
VOXORA_DATABASE_PATH=./data/voxora.db
VOXORA_SECRET_KEY=replace-with-at-least-32-random-characters
# JSON map of operator bearer token -> principal. Never commit real tokens.
VOXORA_API_TOKENS={"dev-operator-token":{"tenant_id":"tenant-demo","role":"admin","name":"Local operator"}}
VOXORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VOXORA_SEED_DEMO=true
VOXORA_WORKER_ENABLED=true
VOXORA_WORKER_POLL_SECONDS=0.5
VOXORA_SIMULATED_CALL_DELAY_SECONDS=0.35
VOXORA_WORKER_THREADS=4
VOXORA_GLOBAL_CONCURRENCY=5
VOXORA_TELEPHONY_PROVIDER=mock
# Live calls are disabled by default. The Twilio adapter is not implemented in this slice.
VOXORA_ALLOW_LIVE_CALLS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
